  m_Script: {fileID: 11500000, guid: 780b8f37253f0134fa363c62fbd6be5c, type: 3}
  m_Name: Mission_01_FirstLight
  m_EditorClassIdentifier: Assembly-CSharp::AstroGame.Mission.MissionData
  missionId: M01
  title: Operation First Light
  targetPlanet: Kepler-7b
  description: Long-range scans have detected an unexplained energy signature beneath
    the dust plains of Kepler-7b. Land at the survey site, restore the relay network
    and recover the signal's data core before the storm front reaches the landing
    zone.
  primaryObjectives:
  - Restore power to the three relay beacons.
  - Route power through the grid without overloading any node.
  - Recover the data core and return to Meridian Station.
  resourcesAndConstraints:
  - 'Rover battery: 100 units'
  - 'Spare relay modules: 2'
  - 'Mission window: 20 minutes'
  - Storm front arrives at T+15 minutes
